---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Problem from '../components/Problem.astro';
import Service from '../components/Service.astro';
import Flow from '../components/Flow.astro';
import Price from '../components/Price.astro';
import CaseSection from '../components/CaseSection.astro';
import Faq from '../components/Faq.astro';
import InquiryForm from '../components/InquiryForm.astro';
import CompanyInfo from '../components/CompanyInfo.astro';
import { contactTel, contactTelHref } from '../data/content';

const jsonLd =
  '{"@context":"https://schema.org","@type":"Service","serviceType":"採用支援（採用LP・AI応募受付・応募者管理）","provider":{"@type":"Organization","name":"株式会社MIMORIA"},"areaServed":"JP"}';

const footerLinks = [
  { href: 'case.html', label: '導入事例（自社）' },
  { href: '#contact', label: 'お問い合わせフォーム' },
  { href: '#faq', label: 'よくある質問' },
  { href: '#company', label: '運営者情報' },
  { href: 'privacy.html', label: 'プライバシーポリシー' },
];
---

<BaseLayout
  title="MIMORIA RECRUIT｜「応募が来る仕組み」を月額で持つ採用支援｜株式会社MIMORIA"
  description="運送・建設・現場系の中小企業向け。紹介会社に1人50万払う前に、正直な採用LP＋24時間AI応募受付＋月次レポートを月額で。制作・運用は当社が代行、応募数は保証しない誠実設計。"
  canonical="https://richend0913.github.io/burning-recruit-lp/"
  gaArea="burning-recruit"
  ogType="website"
  ogTitle="MIMORIA RECRUIT｜『応募が来る仕組み』を月額で持つ"
  ogDescription="採用LP＋AI応募受付＋月次レポート。紹介会社より安く、正直に。"
  brandHref="#top"
  ctaHref="#contact"
  showBar
  footerNotes={[
    '当社は募集の仕組み提供・運用事務代行であり、有料職業紹介事業ではありません。掲載のデモは架空の会社です。',
    '運営：株式会社MIMORIA（神奈川県横浜市）。BURNING BROS. も軽貨物運送でドライバー募集を行う当事者として、この仕組みを実際に使っています。',
  ]}
  footerLinks={footerLinks}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={jsonLd} />
  </Fragment>

  <Hero />
  <Problem />
  <Service />
  <Flow />
  <Price />
  <CaseSection />
  <Faq />
  <InquiryForm />
  <CompanyInfo />

  <Fragment slot="footer-extra">
    <p class="ft-contact">
      お問い合わせ：電話 <a href={contactTelHref}>{contactTel}</a>（BURNING BROS.
      採用担当）／メール <a
        href="mailto:mimoria.inc@gmail.com?subject=MIMORIA%20RECRUIT%20%E7%9B%B8%E8%AB%87"
        >mimoria.inc@gmail.com</a
      >
    </p>
  </Fragment>
</BaseLayout>

<style>
  .ft-contact {
    margin-block-start: 10px;
    max-width: 52rem;
  }
  .ft-contact a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
