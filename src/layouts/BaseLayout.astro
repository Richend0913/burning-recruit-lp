---
import '../styles/global.css';

interface FooterLink {
  href: string;
  label: string;
}

interface Props {
  title: string;
  description: string;
  canonical: string;
  gaArea: string;
  ogType?: string;
  ogTitle?: string;
  ogDescription?: string;
  brandHref?: string;
  ctaHref?: string;
  showBar?: boolean;
  footerNotes?: string[];
  footerLinks: FooterLink[];
}

const {
  title,
  description,
  canonical,
  gaArea,
  ogType,
  ogTitle,
  ogDescription,
  brandHref = 'index.html',
  ctaHref = 'index.html#contact',
  showBar = false,
  footerNotes = [],
  footerLinks,
} = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-63VB4HT3T2"></script>
    <script is:inline define:vars={{ gaArea }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'G-63VB4HT3T2', { page_area: gaArea });
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      ogTitle && (
        <>
          <meta property="og:type" content={ogType ?? 'website'} />
          <meta property="og:title" content={ogTitle} />
          <meta property="og:description" content={ogDescription} />
          <meta property="og:url" content={canonical} />
          <meta
            property="og:image"
            content="https://richend0913.github.io/burning-recruit-lp/og.png"
          />
          <meta name="twitter:card" content="summary_large_image" />
        </>
      )
    }
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Noto+Sans+JP:wght@400;500;700;800;900&display=swap"
      rel="stylesheet"
    />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='9' fill='%231a9e54'/%3E%3Ctext x='16' y='22' font-size='15' font-weight='800' text-anchor='middle' fill='%23ffffff' font-family='sans-serif'%3ER%3C/text%3E%3C/svg%3E"
    />
    <slot name="head" />
  </head>
  <body class={showBar ? undefined : 'no-bar'}>
    <header class="hdr">
      <div class="container hdr-in">
        <a class="brand" href={brandHref}>MIMORIA <span>RECRUIT</span></a>
        <a class="hdr-cta" href={ctaHref}>相談する</a>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="ft">
      <div class="container">
        <p class="ft-name">
          MIMORIA RECRUIT ／ 採用支援（採用LP・応募受付・応募者管理・月次レポート）｜株式会社MIMORIA
        </p>
        {footerNotes.map((note) => <p class="ft-note">{note}</p>)}
        <slot name="footer-extra" />
        <nav class="ft-links" aria-label="フッター">
          {footerLinks.map((link) => <a href={link.href}>{link.label}</a>)}
        </nav>
      </div>
    </footer>

    {
      showBar && (
        <div class="bar">
          <a class="bar-l" href="#price">
            料金を見る
          </a>
          <a class="bar-p" href="#contact">
            無料お試しを相談する
          </a>
        </div>
      )
    }
  </body>
</html>

<style>
  @media (max-width: 859px) {
    body.no-bar {
      padding-block-end: 0;
    }
  }

  /* ヘッダー: 白地＋下ヘアライン */
  .hdr {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-block-end: 1px solid var(--line);
  }
  .hdr-in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 62px;
  }
  @media (min-width: 860px) {
    .hdr-in {
      min-height: 76px;
    }
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 800;
    font-size: 17px;
    letter-spacing: 0.04em;
    text-decoration: none;
    white-space: nowrap;
    color: var(--ink);
  }
  .brand::before {
    content: 'M';
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: var(--accent);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-num);
    font-weight: 800;
    font-size: 16px;
    flex: none;
  }
  .brand span {
    color: var(--accent);
  }
  @media (min-width: 860px) {
    .brand {
      font-size: 18px;
    }
  }
  /* ヘッダー CTA: グリーン塗りの矩形 */
  .hdr-cta {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    background: var(--accent);
    color: #fff;
    text-decoration: none;
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 0.06em;
    padding: 8px 20px;
    border-radius: var(--radius-btn);
    white-space: nowrap;
    flex-shrink: 0;
    transition: background-color 180ms var(--ease-out);
  }
  .hdr-cta:hover {
    background: var(--accent-dark);
  }
  @media (min-width: 860px) {
    .hdr-cta {
      min-height: 46px;
      padding: 10px 30px;
      font-size: 15px;
    }
  }

  /* フッター: 淡いストーン地＋紺文字のライトフッター（旧来の濃いバンドは廃止） */
  .ft {
    background: var(--paper-deep);
    border-block-start: 1px solid var(--line);
    color: var(--ink-2);
    padding-block: 48px 56px;
    font-size: 12.5px;
    line-height: 1.85;
  }
  .ft-name {
    font-weight: 700;
    color: var(--ink);
    font-size: 13.5px;
  }
  .ft-note {
    margin-block-start: 10px;
    max-width: 52rem;
  }
  .ft-links {
    display: flex;
    gap: 8px 24px;
    flex-wrap: wrap;
    margin-block-start: 24px;
    padding-block-start: 20px;
    border-block-start: 1px solid var(--line-strong);
    font-size: 13px;
    font-weight: 700;
  }
  .ft-links a {
    color: var(--ink);
    text-decoration: none;
  }
  .ft-links a:hover {
    color: var(--accent-dark);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* モバイル下部固定 CTA バー（mimoria モバイルカンプの文法: 白いトレイに 2 ボタン） */
  .bar {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 60;
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 10px;
    min-height: var(--bar-h);
    align-items: center;
    background: rgba(255, 255, 255, 0.97);
    border-block-start: 1px solid var(--line);
    box-shadow: 0 -8px 24px -16px rgba(14, 26, 46, 0.25);
    padding: 10px 12px calc(10px + env(safe-area-inset-bottom));
  }
  .bar a {
    min-height: 50px;
    display: grid;
    place-items: center;
    padding-inline: 6px;
    border-radius: var(--radius-btn);
    font-weight: 700;
    font-size: 14.5px;
    letter-spacing: 0.03em;
    line-height: 1.3;
    text-align: center;
    text-decoration: none;
    white-space: nowrap;
  }
  .bar-l {
    background: #fff;
    color: var(--ink);
    border: 1px solid var(--line-strong);
  }
  .bar-p {
    background: var(--accent);
    color: var(--accent-ink);
  }
  @media (max-width: 374px) {
    .bar a {
      font-size: 13px;
      letter-spacing: 0;
    }
  }
  @media (min-width: 860px) {
    .bar {
      display: none;
    }
  }
</style>
