---
import '../styles/global.css';

interface FooterLink {
  href: string;
  label: string;
}

interface Props {
  title: string;
  description: string;
  canonical: string;
  gaArea: string;
  ogType?: string;
  ogTitle?: string;
  ogDescription?: string;
  brandHref?: string;
  ctaHref?: string;
  showBar?: boolean;
  footerNotes?: string[];
  footerLinks: FooterLink[];
}

const {
  title,
  description,
  canonical,
  gaArea,
  ogType,
  ogTitle,
  ogDescription,
  brandHref = 'index.html',
  ctaHref = 'index.html#contact',
  showBar = false,
  footerNotes = [],
  footerLinks,
} = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-63VB4HT3T2"></script>
    <script is:inline define:vars={{ gaArea }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'G-63VB4HT3T2', { page_area: gaArea });
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      ogTitle && (
        <>
          <meta property="og:type" content={ogType ?? 'website'} />
          <meta property="og:title" content={ogTitle} />
          <meta property="og:description" content={ogDescription} />
          <meta property="og:url" content={canonical} />
          <meta
            property="og:image"
            content="https://richend0913.github.io/burning-recruit-lp/og.png"
          />
          <meta name="twitter:card" content="summary_large_image" />
        </>
      )
    }
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Noto+Sans+JP:wght@400;500;700;800;900&display=swap"
      rel="stylesheet"
    />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='9' fill='%23533afd'/%3E%3Ctext x='16' y='22' font-size='15' font-weight='800' text-anchor='middle' fill='%23ffffff' font-family='sans-serif'%3ER%3C/text%3E%3C/svg%3E"
    />
    <slot name="head" />
  </head>
  <body class={showBar ? undefined : 'no-bar'}>
    <header class="hdr">
      <div class="container hdr-in">
        <a class="brand" href={brandHref}>MIMORIA <span>RECRUIT</span></a>
        <a class="hdr-cta" href={ctaHref}>相談する</a>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="ft">
      <div class="container">
        <p class="ft-name">
          MIMORIA RECRUIT ／ 採用支援（採用LP・AI応募受付・応募者管理・月次レポート）｜株式会社MIMORIA
        </p>
        {footerNotes.map((note) => <p class="ft-note">{note}</p>)}
        <slot name="footer-extra" />
        <nav class="ft-links" aria-label="フッター">
          {footerLinks.map((link) => <a href={link.href}>{link.label}</a>)}
        </nav>
      </div>
    </footer>

    {
      showBar && (
        <div class="bar">
          <a class="bar-l" href="#contact">
            フォーム相談
          </a>
          <a class="bar-p" href="#demo">
            デモを見る
          </a>
        </div>
      )
    }
  </body>
</html>

<style>
  @media (max-width: 859px) {
    body.no-bar {
      padding-block-end: 0;
    }
  }

  .hdr {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.88);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-block-end: 1px solid var(--line);
  }
  .hdr-in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 62px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 800;
    font-size: 17px;
    letter-spacing: 0.03em;
    text-decoration: none;
    white-space: nowrap;
  }
  .brand::before {
    content: 'M';
    width: 30px;
    height: 30px;
    border-radius: 9px;
    background: var(--accent);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-num);
    font-weight: 800;
    font-size: 15px;
    box-shadow: 0 6px 16px rgba(10, 37, 64, 0.22);
    flex: none;
  }
  .brand span {
    color: var(--accent);
  }
  .hdr-cta {
    background: var(--ink);
    color: #fff;
    text-decoration: none;
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 0.04em;
    padding: 10px 22px;
    border-radius: 999px;
    box-shadow: 0 8px 20px rgba(10, 37, 64, 0.24);
    white-space: nowrap;
    flex-shrink: 0;
    transition: background-color 180ms var(--ease-out);
  }
  .hdr-cta:hover {
    background: var(--accent);
  }

  .ft {
    background: var(--ink-deep);
    color: #adbdcc;
    padding-block: 56px 64px;
    font-size: 12.5px;
  }
  .ft-name {
    font-weight: 700;
    color: #fff;
    font-size: 13px;
  }
  .ft-note {
    margin-block-start: 10px;
    max-width: 52rem;
  }
  .ft-links {
    display: flex;
    gap: 8px 20px;
    flex-wrap: wrap;
    margin-block-start: 20px;
    font-size: 13px;
  }
  .ft-links a {
    color: #dbe4f0;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .bar {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 60;
    display: flex;
    background: #fff;
    border-block-start: 1px solid var(--line);
    padding-bottom: env(safe-area-inset-bottom);
  }
  .bar a {
    flex: 1;
    min-height: 56px;
    display: grid;
    place-items: center;
    font-weight: 700;
    font-size: 15px;
    letter-spacing: 0.05em;
    text-decoration: none;
  }
  .bar-l {
    color: var(--ink);
    border-inline-end: 1px solid var(--line);
  }
  .bar-p {
    background: var(--accent);
    color: var(--accent-ink);
  }
  @media (min-width: 860px) {
    .bar {
      display: none;
    }
  }
</style>
