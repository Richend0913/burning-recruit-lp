---
import SectionHead from './SectionHead.astro';
import Phrases from './Phrases.astro';
import { flowSteps, introSteps } from '../data/content';
---

<section class="section section--alt" id="flow">
  <div class="container">
    <SectionHead no="03" label="応募の流れ" title="求職者が見てから、応募が御社に届くまで。" />
    <div class="flow-panel">
      <div class="steps steps--row">
        {
          flowSteps.map((s, i) => (
            <div class="step-item">
              <span class="sno">{i + 1}</span>
              <h3>
                <Phrases text={s.title} />
              </h3>
              <p>
                <Phrases text={s.body} />
              </p>
            </div>
          ))
        }
      </div>
    </div>

    <h3 class="sub-title"><Phrases text="導入の流れ（ご利用開始まで）" /></h3>
    <div class="flow-panel">
      <div class="steps steps--row">
        {
          introSteps.map((s, i) => (
            <div class="step-item">
              <span class="sno">{i + 1}</span>
              <h3>
                <Phrases text={s.title} />
              </h3>
              <p>
                <Phrases text={s.body} />
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  /* 2 つの流れを同じ PROCESS 文法の白パネルに載せる */
  .flow-panel {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-plan);
    box-shadow: var(--shadow-sm);
    padding: 28px 22px;
  }
  .sub-title {
    font-size: 20px;
    line-height: 1.5;
    margin-block: 64px 20px;
  }
  @media (min-width: 860px) {
    .flow-panel {
      padding: 44px 40px 46px;
    }
    .sub-title {
      text-align: center;
      font-size: 22px;
      margin-block: 80px 28px;
    }
  }
</style>
