---
import Phrases from './Phrases.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

/* ヒーローの信頼チェック行。いずれも LP 既存コピーの事実のみで構成する */
const checks = [
  'お試し3ヶ月は月額無料（費用は継続時のみ）',
  'お試し期間中も MIMORIA JOBS への求人掲載が無料',
  'いつでも解約可',
  '応募データは御社のもの',
];
---

<section class="hero" id="top">
  <div class="container">
    <div class="hero-grid">
      <div class="hero-main">
        <p class="hero-eyebrow">運送・建設・現場系の中小企業へ</p>
        <h1 class="hero-title">
          <Phrases text="運送・建設の採用を、" /><span class="hl"
            ><Phrases text="採用ページ＋" /><Phrases text="24時間応募受付" /></span
          ><Phrases text="で仕組み化する。" />
        </h1>
        <p class="hero-sub">
          <Phrases
            text="応募が来ない、電話に出られない時間に応募を逃す、応募の管理がバラバラ——その困りごとを、採用ページの制作と24時間の応募受付の仕組みで受け止めます。制作も運用も当社が代行。応募数は保証しない、誠実な設計です。"
          />
        </p>
        <div class="hero-btns">
          <a class="btn btn--primary btn--arrow" href="#contact">無料お試しを相談する</a>
          <a class="btn btn--ghost" href="#price">料金を見る</a>
        </div>
        <ul class="hero-checks">
          {
            checks.map((c) => (
              <li>
                <svg viewBox="0 0 20 20" aria-hidden="true">
                  <circle cx="10" cy="10" r="10" fill="#1aa34a" />
                  <path
                    d="M6 10.4l2.6 2.6L14 7.4"
                    fill="none"
                    stroke="#fff"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
                <span>{c}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <figure class="hero-photo">
        <img
          src={`${base}hero-driver.webp`}
          alt="開いたトラックのドアにもたれ、笑顔で立つ作業着姿のドライバー"
          width="1920"
          height="1280"
          fetchpriority="high"
          decoding="async"
        />
      </figure>
    </div>
    <a class="proof" href="#demo" aria-label="制作デモの実物を見る">
      <span class="proof-bar" aria-hidden="true"><i></i><i></i><i></i><b></b></span>
      <span class="proof-media">
        <img
          src={`${base}demo-scene.jpg`}
          alt="制作デモ（架空の運送会社の採用ページ）の実物画面"
          width="2560"
          height="2280"
          loading="lazy"
          decoding="async"
        />
      </span>
    </a>
  </div>
</section>

<style>
  /* 白基調のヒーロー。実物パネルは下端から次のストーンバンド（課題）へ食い込ませる */
  .hero {
    position: relative;
    padding-block: 28px 0;
    background: var(--paper);
  }
  .hero .container {
    position: relative;
    z-index: 2;
  }
  /* SP: 特大見出し → フル幅写真ブロック → リード → CTA → チェック（mimoria モバイル文法） */
  .hero-grid {
    display: flex;
    flex-direction: column;
  }
  .hero-main {
    display: contents;
  }
  .hero-eyebrow,
  .hero-title {
    order: 1;
  }
  .hero-photo {
    order: 2;
  }
  .hero-sub,
  .hero-btns,
  .hero-checks {
    order: 3;
  }
  .hero-btns {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    align-items: center;
    margin-block-start: 28px;
  }
  .hero-btns .btn {
    flex: 1 1 220px;
  }
  /* 信頼チェック行: 上下ヘアラインで区切ったストリップ（カンプ下部の文法） */
  .hero-checks {
    list-style: none;
    display: grid;
    gap: 10px 28px;
    margin-block-start: 28px;
    padding-block: 18px;
    border-block: 1px solid var(--line);
  }
  .hero-checks li {
    display: flex;
    align-items: flex-start;
    gap: 9px;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--ink);
    line-height: 1.6;
  }
  .hero-checks svg {
    width: 17px;
    height: 17px;
    flex: none;
    margin-block-start: 3px;
  }
  .hero-checks circle {
    fill: var(--accent);
  }
  /* 写真: SP はコンテナ外まで広げたフル幅ブロック */
  .hero-photo {
    margin-block-start: 26px;
    margin-inline: -20px;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--paper-alt);
  }
  .hero-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 72% 40%;
  }
  /* 制作デモの実物パネル（ブラウザ枠つき） */
  .proof {
    display: block;
    position: relative;
    z-index: 3;
    margin-block-start: 48px;
    margin-block-end: -56px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius-plan);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
    text-decoration: none;
    transition:
      box-shadow 200ms var(--ease-out),
      border-color 200ms var(--ease-out);
  }
  .proof:hover {
    border-color: #cfe9d7;
    box-shadow:
      0 28px 56px -18px rgba(14, 26, 46, 0.26),
      0 10px 24px -12px rgba(14, 26, 46, 0.14);
  }
  .proof-bar {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 11px 16px;
    background: var(--paper-alt);
    border-block-end: 1px solid var(--line);
  }
  .proof-bar i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #dcd9d0;
  }
  .proof-bar i:first-child {
    background: var(--accent);
  }
  .proof-bar b {
    flex: 1;
    max-width: 320px;
    height: 18px;
    margin-inline-start: 12px;
    border-radius: 5px;
    background: #fff;
    border: 1px solid var(--line);
  }
  .proof-media {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }
  .proof-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }
  @media (min-width: 860px) {
    .hero {
      padding-block-start: 64px;
    }
    .hero-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.08fr) minmax(0, 1fr);
      align-items: center;
      gap: 48px;
    }
    .hero-main {
      display: block;
    }
    .hero-btns {
      margin-block-start: 34px;
    }
    .hero-btns .btn {
      flex: 0 0 auto;
      min-width: 220px;
    }
    .hero-checks {
      margin-block-start: 36px;
    }
    .hero-photo {
      margin: 0;
      border-radius: var(--radius-photo);
      aspect-ratio: 4 / 4.2;
      box-shadow: var(--shadow-md);
    }
    .hero-photo img {
      object-position: 70% 40%;
    }
    .proof {
      margin-block-start: 72px;
      margin-block-end: -96px;
    }
    .proof-media {
      aspect-ratio: 16 / 10;
    }
  }
  @media (min-width: 1120px) {
    .hero-checks {
      grid-template-columns: 1fr 1fr;
    }
    .hero-photo {
      aspect-ratio: 1 / 1;
    }
  }
  /* SP: 写真先行ヒーロー。フル幅写真の上部（空側）にアイブロウ＋見出しを重ねる */
  @media (max-width: 859.98px) {
    .hero {
      padding-block-start: 0;
    }
    .hero-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
    }
    .hero-photo {
      grid-area: 1 / 1;
      position: relative;
      margin-block-start: 0;
      aspect-ratio: 4 / 4.7;
      min-height: 470px;
    }
    .hero-photo::after {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(
        to bottom,
        rgba(255, 255, 255, 0.93) 0%,
        rgba(255, 255, 255, 0.82) 34%,
        rgba(255, 255, 255, 0.38) 62%,
        rgba(255, 255, 255, 0) 82%
      );
      pointer-events: none;
    }
    .hero-eyebrow {
      grid-area: 1 / 1;
      align-self: start;
      position: relative;
      z-index: 2;
      margin-block-start: 22px;
    }
    .hero-title {
      grid-area: 1 / 1;
      align-self: start;
      position: relative;
      z-index: 2;
      margin-block-start: 59px;
    }
    .hero-sub {
      margin-block-start: 24px;
    }
  }
</style>
