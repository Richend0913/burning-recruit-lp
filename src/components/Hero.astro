---
import Phrases from './Phrases.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<section class="hero" id="top">
  <div class="mesh mesh--deep" aria-hidden="true"></div>
  <div class="container">
    <p class="hero-eyebrow">運送・建設・現場系の中小企業へ</p>
    <h1 class="hero-title">
      <Phrases text="運送・建設の採用を、" /><span class="hl"
        ><Phrases text="採用ページ＋24時間応募受付" /></span
      ><Phrases text="で仕組み化する。" />
    </h1>
    <p class="hero-sub">
      <Phrases
        text="応募が来ない、電話に出られない時間に応募を逃す、応募の管理がバラバラ——その困りごとを、採用ページの制作と24時間の応募受付の仕組みで受け止めます。制作も運用も当社が代行。応募数は保証しない、誠実な設計です。"
      />
    </p>
    <div class="hero-btns">
      <a class="btn btn--white btn--arrow" href="#contact">無料お試しを相談する</a>
      <a class="tlink tlink--light" href="#price">料金を見る</a>
    </div>
    <p class="hero-note">お試し3ヶ月は月額無料（費用は継続時のみ）／ いつでも解約可 ／ 応募データは御社のもの</p>
    <a class="proof" href="#demo" aria-label="制作デモの実物を見る">
      <span class="proof-bar" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="proof-media">
        <img
          src={`${base}demo-scene.jpg`}
          alt="制作デモ（架空の運送会社の採用ページ）の実物画面"
          width="2560"
          height="2280"
          decoding="async"
        />
      </span>
    </a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: 56px 0;
  }
  .hero .container {
    position: relative;
    z-index: 2;
  }
  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    padding: 7px 16px;
    border: 1px solid rgba(255, 255, 255, 0.45);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.14);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #fff;
    margin-block-end: 26px;
  }
  .hero-title {
    font-size: var(--fs-display);
    font-weight: 900;
    line-height: 1.3;
    letter-spacing: -0.02em;
    color: #fff;
    text-shadow: 0 2px 28px rgba(38, 18, 120, 0.28);
  }
  .hero-title .hl {
    color: #fff;
    text-decoration: underline;
    text-decoration-color: var(--mesh-orange);
    text-decoration-thickness: 0.09em;
    text-underline-offset: 0.14em;
  }
  .hero-sub {
    margin-block-start: 28px;
    color: rgba(255, 255, 255, 0.94);
    font-weight: 500;
    font-size: var(--fs-lead);
    line-height: 1.9;
    max-width: 38em;
  }
  .hero-btns {
    display: flex;
    gap: 18px 28px;
    flex-wrap: wrap;
    align-items: center;
    margin-block-start: 36px;
  }
  .hero-note {
    margin-block-start: 22px;
    font-size: 13px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.95);
    text-shadow: 0 1px 12px rgba(38, 18, 120, 0.35);
  }
  /* 制作デモの実物パネル: ヒーロー下端から次のセクションへ食い込ませる */
  .proof {
    display: block;
    position: relative;
    z-index: 3;
    margin-block-start: 48px;
    margin-block-end: -56px;
    background: #fff;
    border-radius: 16px;
    box-shadow: var(--shadow-lg);
    overflow: hidden;
    text-decoration: none;
    transition: box-shadow 220ms var(--ease-out);
  }
  .proof:hover {
    box-shadow:
      0 36px 68px -12px rgba(50, 50, 93, 0.32),
      0 20px 40px -18px rgba(0, 0, 0, 0.26);
  }
  .proof-bar {
    display: flex;
    gap: 7px;
    padding: 12px 16px;
    border-block-end: 1px solid var(--line-soft);
  }
  .proof-bar i {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: #dfe6ee;
  }
  .proof-media {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }
  .proof-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }
  @media (min-width: 860px) {
    .hero {
      padding-block-start: 84px;
    }
    .hero-title {
      line-height: 1.24;
    }
    .proof {
      margin-block-start: 56px;
      margin-block-end: -80px;
    }
    .proof-media {
      aspect-ratio: 16 / 10;
    }
  }
</style>
