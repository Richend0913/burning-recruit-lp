---
import Phrases from './Phrases.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

/* ヒーローの信頼チェック行。いずれも LP 既存コピーの事実のみで構成する */
const checks = [
  'お試し3ヶ月は月額無料（費用は継続時のみ）',
  'お試し期間中も MIMORIA JOBS への求人掲載が無料',
  'いつでも解約可',
  '応募データは御社のもの',
];
---

<section class="hero" id="top">
  <div class="container">
    <div class="hero-grid">
      <div class="hero-main">
        <p class="hero-eyebrow">運送・建設・現場系の中小企業へ</p>
        <h1 class="hero-title">
          <Phrases text="運送・建設の採用を、" /><span class="hl"
            ><Phrases text="採用ページ＋" /><Phrases text="24時間応募受付" /></span
          ><Phrases text="で仕組み化する。" />
        </h1>
        <p class="hero-sub">
          <Phrases
            text="応募が来ない、電話に出られない時間に応募を逃す、応募の管理がバラバラ——その困りごとを、採用ページの制作と24時間の応募受付の仕組みで受け止めます。制作も運用も当社が代行。応募数は保証しない、誠実な設計です。"
          />
        </p>
        <div class="hero-btns">
          <a class="btn btn--primary btn--arrow" href="#contact">無料お試しを相談する</a>
          <a class="btn btn--ghost" href="#price">料金を見る</a>
        </div>
        <ul class="hero-checks">
          {
            checks.map((c) => (
              <li>
                <svg viewBox="0 0 20 20" aria-hidden="true">
                  <circle cx="10" cy="10" r="10" fill="#1a9e54" />
                  <path
                    d="M6 10.4l2.6 2.6L14 7.4"
                    fill="none"
                    stroke="#fff"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
                <span>{c}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <figure class="hero-photo">
        <img
          src={`${base}photo-warehouse.webp`}
          alt="配送センターで、コンベア上の段ボールを仕分けるスタッフと、荷受け口に停まる軽バン"
          width="1920"
          height="1280"
          decoding="async"
        />
      </figure>
    </div>
    <a class="proof" href="#demo" aria-label="制作デモの実物を見る">
      <span class="proof-bar" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="proof-media">
        <img
          src={`${base}demo-scene.jpg`}
          alt="制作デモ（架空の運送会社の採用ページ）の実物画面"
          width="2560"
          height="2280"
          decoding="async"
        />
      </span>
    </a>
  </div>
</section>

<style>
  /* 実測（/tmp/fidelity/measured.md）:
     写真パネル = コンテナの 50% 幅・アスペクト 1.91:1・角丸 ≈ 幅の 2%・影なし
     見出し/リード ≈ 2.15、見出し→リード 0.5em、バンドは硬いエッジ */
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: 40px 0;
    /* ヒーローは淡いブルーグレーのバンド。実物パネルの途中で白へ切り替える（硬いエッジ） */
    background: linear-gradient(180deg, var(--paper-alt) 0, var(--paper-alt) calc(100% - 140px), #fff calc(100% - 140px));
  }
  .hero .container {
    position: relative;
    z-index: 2;
  }
  .hero-grid {
    display: grid;
    gap: 32px;
  }
  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    padding: 6px 16px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: #fff;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--accent-dark);
    margin-block-end: 22px;
  }
  .hero-title {
    font-size: var(--fs-display);
    font-weight: 900;
    line-height: 1.3;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .hero-title .hl {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 0.09em;
    text-underline-offset: 0.14em;
  }
  /* リードはカンプ同様に濃いインク（実測 #171c2d）で、太さは標準 */
  .hero-sub {
    margin-block-start: 20px;
    color: #1f2a3c;
    font-weight: 400;
    font-size: var(--fs-hero-lead);
    line-height: 1.75;
    max-width: 38em;
  }
  .hero-btns {
    display: flex;
    gap: 12px 14px;
    flex-wrap: wrap;
    align-items: center;
    margin-block-start: 28px;
  }
  /* 信頼チェック行（カンプの緑チェック列: アイコン ≈ 文字サイズ） */
  .hero-checks {
    list-style: none;
    display: grid;
    gap: 8px 24px;
    margin-block-start: 24px;
  }
  .hero-checks li {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--ink);
    line-height: 1.6;
  }
  .hero-checks svg {
    width: 16px;
    height: 16px;
    flex: none;
    margin-block-start: 3px;
  }
  .hero-checks circle {
    fill: var(--accent);
  }
  /* 右の写真パネル（カンプ: 影なし・控えめな角丸） */
  .hero-photo {
    border-radius: var(--radius-photo);
    overflow: hidden;
    aspect-ratio: 16 / 10;
  }
  .hero-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 26%;
  }
  /* 制作デモの実物パネル: ヒーロー下端から次のセクションへ食い込ませる */
  .proof {
    display: block;
    position: relative;
    z-index: 3;
    margin-block-start: 48px;
    margin-block-end: -56px;
    background: #fff;
    border-radius: 16px;
    box-shadow: var(--shadow-lg);
    overflow: hidden;
    text-decoration: none;
    transition: box-shadow 220ms var(--ease-out);
  }
  .proof:hover {
    box-shadow:
      0 30px 56px -12px rgba(18, 40, 60, 0.26),
      0 16px 32px -14px rgba(18, 40, 60, 0.18);
  }
  .proof-bar {
    display: flex;
    gap: 7px;
    padding: 12px 16px;
    border-block-end: 1px solid var(--line-soft);
  }
  .proof-bar i {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: #dfe6ee;
  }
  .proof-media {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }
  .proof-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }
  @media (min-width: 860px) {
    .hero {
      padding-block-start: 64px;
      background: linear-gradient(180deg, var(--paper-alt) 0, var(--paper-alt) calc(100% - 240px), #fff calc(100% - 240px));
    }
    /* 写真 = コンテナの 50%、段間 ≈ 3.7%（実測） */
    .hero-grid {
      grid-template-columns: minmax(0, 1fr) 50%;
      align-items: center;
      gap: 40px;
    }
    .hero-title {
      line-height: 1.28;
    }
    /* カンプ同様、チェック項目は横並びで流す（幅が足りない項目だけ次の行へ） */
    .hero-checks {
      display: flex;
      flex-wrap: wrap;
      gap: 8px 22px;
    }
    .hero-photo {
      aspect-ratio: 1.91 / 1;
    }
    .hero-photo img {
      object-position: 50% 30%;
    }
    .proof {
      margin-block-start: 64px;
      margin-block-end: -80px;
    }
    .proof-media {
      aspect-ratio: 16 / 10;
    }
  }
</style>
