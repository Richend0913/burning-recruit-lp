---
import SectionHead from './SectionHead.astro';
import Phrases from './Phrases.astro';
import { plans, jobsUrl } from '../data/content';

/* 価格文字列（例「月 80,000円」）を、表示テキストを変えずに「接頭・数字・接尾」へ分けて大数字化する。
   分割できない形式のときは文字列をそのまま出す */
const splitPrice = (price: string) => {
  const m = price.match(/^(\D*?)([\d,]+)(\D*)$/);
  return m ? { pre: m[1], num: m[2], post: m[3] } : null;
};
---

<section class="section" id="price">
  <div class="container">
    <SectionHead no="04" label="料金" title="料金プランと、お試し条件です。" />

    <div class="plans">
      {
        plans.map((plan) => {
          const p = splitPrice(plan.price);
          return (
            <div class={plan.recommended ? 'plan plan--rec' : 'plan'}>
              {plan.recommended && <p class="plan-tag">おすすめ</p>}
              <p class="plan-name">{plan.name}</p>
              <p class="plan-price">
                {p ? (
                  <><span class="pp-unit">{p.pre}</span><span class="pp-num">{p.num}</span><span class="pp-unit">{p.post}</span></>
                ) : (
                  plan.price
                )}
              </p>
              <p class="plan-note">{plan.note}</p>
            </div>
          );
        })
      }
    </div>

    <div class="block block--trial center-block">
      <h3><Phrases text="まずは3ヶ月のお試し期間から" /></h3>
      <p>
        <Phrases
          text="いきなりの長期契約は求めません。まずは3ヶ月のお試し期間から開始できます。"
        /><strong
          ><Phrases
            text="お試し期間（3ヶ月）は月額料金無料。初期費用・月額料金は、お試し期間終了後に継続（本契約へ移行）する場合にのみ発生します。お試しのみで終了すれば、費用は一切かかりません。"
          /></strong
        ><Phrases
          text="期間中はいつでも解約できます。3ヶ月使ってみて、数字と手応えを見てから続けるかどうかをご判断ください。"
        />
      </p>
    </div>

    <div class="block center-block">
      <h3><Phrases text="ご契約特典" /></h3>
      <p>
        <Phrases text="ご契約中はもちろん、お試し期間中も、求人サイト " /><a
          class="a-link"
          href={jobsUrl}
          target="_blank"
          rel="noopener">MIMORIA JOBS</a
        ><Phrases
          text=" への求人掲載が無料です。採用LPに加えて求人サイトにも求人を掲載し、応募の入口を広げられます（掲載無料の特典付き）。"
        />
      </p>
    </div>

    <div class="notice honest center-block">
      <p>
        <strong>正直にお伝えします。</strong>
        <strong>応募数は保証しません。</strong
        >3ヶ月応募がゼロなら、契約の休止をこちらから提案します。いつでも解約でき、応募データは御社のものです。当社は候補者の選別・推薦・採否には関与しません（それをやると有料職業紹介の許可が必要になり、線引きを守るためです）。実績は現在、支援先（BURNING
        BROS.）で積み上げ中です——数字が出てから胸を張ってご提案します。実際に支援先で運用している仕組みの実物は、こちらで公開しています。<a
          href="case.html">支援事例を見る →</a
        >
      </p>
    </div>
  </div>
</section>

<style>
  /* カンプ PRICING 文法: 白カード横並び、推奨はグリーン 2px 枠＋上中央の「おすすめ」バッジ */
  .plans {
    display: grid;
    gap: 28px;
    max-width: 920px;
    margin-inline: auto;
    padding-block-start: 12px;
  }
  .plan {
    position: relative;
    display: grid;
    gap: 6px;
    align-content: start;
    text-align: center;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-plan);
    box-shadow: var(--shadow-sm);
    padding: 34px 24px 0;
    overflow: hidden;
  }
  .plan--rec {
    border: 2px solid var(--accent);
    padding: 33px 23px 0;
    overflow: visible;
    box-shadow: 0 18px 40px -20px rgba(19, 138, 60, 0.35);
  }
  .plan-tag {
    position: absolute;
    top: -15px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--accent);
    color: #fff;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1;
    padding: 8px 20px;
    border-radius: 6px;
    white-space: nowrap;
  }
  .plan-name {
    font-weight: 800;
    font-size: 18px;
    letter-spacing: 0.06em;
  }
  .plan--rec .plan-name {
    color: var(--accent-dark);
  }
  .plan-price {
    display: flex;
    justify-content: center;
    align-items: baseline;
    gap: 6px;
    white-space: nowrap;
    line-height: 1.2;
    margin-block: 4px 6px;
  }
  .pp-num {
    font-family: var(--font-num);
    font-weight: 700;
    font-size: 44px;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
  }
  .pp-unit {
    font-size: 16px;
    font-weight: 700;
    color: var(--ink-2);
  }
  .plan-note {
    color: var(--ink-2);
    font-size: 13.5px;
    line-height: 1.75;
    background: var(--paper-strip);
    border-block-start: 1px solid var(--line);
    margin: 18px -24px 0;
    padding: 14px 20px;
  }
  .plan--rec .plan-note {
    margin-inline: -23px;
    background: var(--accent-tint);
    border-block-start-color: var(--accent-tint-2);
    border-radius: 0 0 12px 12px;
  }
  @media (min-width: 860px) {
    .plans {
      grid-template-columns: 1fr 1fr;
    }
    .plan {
      padding: 40px 36px 0;
    }
    .plan--rec {
      padding: 39px 35px 0;
    }
    .pp-num {
      font-size: 52px;
    }
    .plan-note {
      font-size: 14px;
      margin-inline: -36px;
      padding: 16px 28px;
    }
    .plan--rec .plan-note {
      margin-inline: -35px;
    }
  }

  .block {
    margin-block-start: 24px;
    max-width: 920px;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    padding: 26px 24px;
  }
  .block h3 {
    font-size: var(--fs-h3);
    margin-block-end: 10px;
  }
  .block p {
    color: var(--ink-2);
    font-size: 15px;
    line-height: 1.9;
  }
  .block p strong {
    color: var(--ink);
  }
  /* お試し条件: 淡いグリーンのバンド */
  .block--trial {
    margin-block-start: 48px;
    background: var(--accent-tint);
    border-color: var(--accent-tint-2);
    box-shadow: none;
  }
  .block--trial h3 {
    color: var(--accent-dark);
  }
  .block--trial p strong {
    background: linear-gradient(transparent 62%, rgba(26, 163, 74, 0.16) 62%);
  }
  @media (min-width: 860px) {
    .block {
      padding: 32px 40px;
    }
  }

  .honest {
    margin-block-start: 24px;
    max-width: 920px;
  }
</style>
