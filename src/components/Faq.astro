---
import SectionHead from './SectionHead.astro';
import Phrases from './Phrases.astro';
import { faqItems } from '../data/content';
---

<section class="section section--alt" id="faq">
  <div class="container">
    <SectionHead no="06" label="よくある質問" title="契約の前に、正直に答えます" />
    <div class="faq-list">
      {
        faqItems.map((item) => (
          <details>
            <summary>
              <span><Phrases text={item.q} /></span>
            </summary>
            <p>
              <Phrases text={item.a} />
            </p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq-list {
    display: grid;
    gap: 12px;
    max-width: 46rem;
  }
  details {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 16px;
    box-shadow: var(--shadow-sm);
    padding: 20px 24px;
  }
  summary {
    font-weight: 700;
    font-size: 16px;
    letter-spacing: 0.02em;
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: '＋';
    font-weight: 400;
    color: var(--accent);
    font-size: 15px;
    flex: none;
  }
  details[open ] summary::after {
    content: '−';
  }
  details p {
    color: var(--ink-2);
    font-size: 15px;
    line-height: 1.85;
    margin-block-start: 10px;
    max-width: var(--w-text);
  }
</style>
