---
import SectionHead from './SectionHead.astro';
import Phrases from './Phrases.astro';
import { problems, compareRows } from '../data/content';

/* 課題カードのラインアイコン。problems の並び順に対応 */
const icons = [
  // 応募がそもそも来ない: 虫眼鏡
  '<circle cx="11" cy="11" r="7" /><path d="M20.5 20.5L16.7 16.7" />',
  // 電話に出られない時間に応募を逃す: 受話器
  '<path d="M21 16.9v2.6a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 1.1 3.7 2 2 0 0 1 3.1 1.5h2.6a2 2 0 0 1 2 1.7c.13.96.36 1.9.7 2.8a2 2 0 0 1-.45 2.1L6.7 12.9a16 16 0 0 0 6 6l1.25-1.25a2 2 0 0 1 2.1-.45c.9.34 1.85.57 2.8.7A2 2 0 0 1 21 16.9z" />',
  // 応募の管理が媒体ごとにバラバラ: グリッド
  '<rect x="3" y="3" width="7" height="7" rx="1.5" /><rect x="14" y="3" width="7" height="7" rx="1.5" /><rect x="3" y="14" width="7" height="7" rx="1.5" /><rect x="14" y="14" width="7" height="7" rx="1.5" />',
];
---

<section class="section section--alt" id="problem">
  <div class="container">
    <SectionHead no="01" label="課題" title="採用の困りごとは、だいたいこの3つです。" />
    <div class="rows rows--3col rows--icons">
      {
        problems.map((item, i) => (
          <div class="row-item">
            <span class="l-icon" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={icons[i]}
              />
            </span>
            <h3>
              <Phrases text={item.title} />
            </h3>
            <p>
              <Phrases text={item.body} />
            </p>
          </div>
        ))
      }
    </div>
    <p class="lead after center-block">
      <Phrases text="そのうえ採用のたびに大きな費用がかかる構造も、現場の負担になっています。" />
    </p>
    <table class="cmp">
      <tbody>
        {
          compareRows.map((row) => (
            <tr class={row.us ? 'us' : undefined}>
              <th scope="row">{row.name}</th>
              <td class="cmp-price">
                {row.price}
                {row.unit && <span class="cmp-unit">{row.unit}</span>}
              </td>
              <td class="cmp-desc">{row.desc}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
    <p class="note">
      ※
      金額はいずれも一般的な相場の目安で、実額は業種・地域・条件で変わります。当社は「募集の仕組みの提供と運用事務代行」です。候補者の選別・推薦・採否には関与しません（募集主体は御社）。
    </p>
  </div>
</section>

<style>
  /* 課題カード: 白カードの左上にグリーンのラインアイコン */
  .rows--icons .l-icon {
    margin-block-end: 20px;
  }
  .after {
    margin-block-start: 56px;
    font-weight: 700;
    color: var(--ink);
  }
  @media (min-width: 860px) {
    .after {
      margin-block-start: 72px;
      text-align: center;
    }
  }

  /* 料金比較: エレガントな表。自社行はグリーン枠＋淡いティントで強調 */
  .cmp {
    width: 100%;
    max-width: 960px;
    margin-inline: auto;
    border-collapse: separate;
    border-spacing: 0 10px;
    margin-block-start: 18px;
    font-size: 15px;
  }
  .cmp tr {
    background: var(--paper);
  }
  .cmp th,
  .cmp td {
    padding: 22px 28px;
    text-align: left;
    vertical-align: middle;
    border-block: 1px solid var(--line);
  }
  .cmp th {
    border-inline-start: 1px solid var(--line);
    border-start-start-radius: var(--radius);
    border-end-start-radius: var(--radius);
    font-weight: 700;
    letter-spacing: 0.03em;
    white-space: nowrap;
    width: 24%;
  }
  .cmp-desc {
    border-inline-end: 1px solid var(--line);
    border-start-end-radius: var(--radius);
    border-end-end-radius: var(--radius);
    color: var(--ink-2);
    font-size: 14px;
  }
  .cmp-price {
    font-family: var(--font-num);
    font-weight: 700;
    font-size: 24px;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.01em;
    white-space: nowrap;
    width: 24%;
    color: var(--ink);
  }
  .cmp-unit {
    font-family: var(--font);
    font-size: 13px;
    font-weight: 500;
    color: var(--ink-3);
    margin-inline-start: 3px;
  }
  .cmp tr.us {
    background: var(--accent-tint);
  }
  .cmp tr.us th,
  .cmp tr.us td {
    border-color: var(--accent);
    border-block-width: 2px;
  }
  .cmp tr.us th {
    border-inline-start-width: 2px;
  }
  .cmp tr.us .cmp-desc {
    border-inline-end-width: 2px;
    color: var(--ink);
  }
  .cmp tr.us th,
  .cmp tr.us .cmp-price {
    color: var(--accent-dark);
  }
  @media (max-width: 640px) {
    .cmp,
    .cmp tbody {
      display: grid;
      gap: 10px;
    }
    .cmp tr {
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: baseline;
      padding: 18px 20px;
      border: 1px solid var(--line);
      border-radius: var(--radius);
    }
    .cmp tr.us {
      border: 2px solid var(--accent);
      padding: 17px 19px;
    }
    .cmp th,
    .cmp td,
    .cmp tr.us th,
    .cmp tr.us td {
      padding: 0;
      border: 0;
      border-radius: 0;
    }
    .cmp th {
      width: auto;
      font-size: 14px;
      padding-inline-end: 10px;
      white-space: normal;
    }
    .cmp-price {
      width: auto;
      font-size: 20px;
      text-align: right;
    }
    .cmp-desc {
      grid-column: 1 / -1;
      font-size: 13.5px;
      margin-block-start: 6px;
    }
  }
  .note {
    margin-block-start: 14px;
    margin-inline: auto;
    color: var(--ink-3);
    font-size: 13.5px;
    line-height: 1.85;
    max-width: 960px;
  }
</style>
