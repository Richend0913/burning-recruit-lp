---
import SectionHead from './SectionHead.astro';
import { lineUrl } from '../data/content';
---

<section class="section section--rule" id="contact">
  <div class="container contact-grid">
    <SectionHead
      no="07"
      label="お問い合わせ"
      title="まずは、今の採用の困りごとから。"
      lead="「応募が来ない」「すぐ辞める」の背景を伺い、採用LPのデモをお見せします。しつこい営業はしません。"
    />
    <!-- フォーム送信は formsubmit.co 経由で info@mimoria.jp へ届きます。
         初回送信時に formsubmit から有効化（activation）メールがその受信箱に届くので、運営側で一度だけリンクをクリックして有効化してください。 -->
    <form class="inq center-block" id="inquiry-form" novalidate>
      <div class="fld">
        <label for="f-company">会社名<span class="req">必須</span></label>
        <input type="text" id="f-company" name="会社名" autocomplete="organization" required />
      </div>
      <div class="fld">
        <label for="f-name">担当者名<span class="req">必須</span></label>
        <input type="text" id="f-name" name="担当者名" autocomplete="name" required />
      </div>
      <div class="fld">
        <label for="f-email">メールアドレス<span class="req">必須</span></label>
        <input type="email" id="f-email" name="メールアドレス" autocomplete="email" required />
      </div>
      <div class="fld">
        <label for="f-tel">電話番号</label>
        <input type="tel" id="f-tel" name="電話番号" autocomplete="tel" />
      </div>
      <div class="fld">
        <label for="f-size">従業員規模</label>
        <select id="f-size" name="従業員規模">
          <option value="">選択してください</option>
          <option>1〜9名</option>
          <option>10〜29名</option>
          <option>30〜49名</option>
          <option>50〜99名</option>
          <option>100名以上</option>
          <option>未定・その他</option>
        </select>
      </div>
      <div class="fld">
        <label for="f-message">相談内容</label>
        <textarea
          id="f-message"
          name="相談内容"
          placeholder="例：ドライバーの応募が月に1件あるかないかで困っています。"
        ></textarea>
      </div>
      <div class="fld hp-field" aria-hidden="true">
        <label
          >この欄は入力しないでください<input
            type="text"
            id="f-honey"
            name="_honey"
            tabindex="-1"
            autocomplete="off"
          /></label
        >
      </div>
      <div class="fld">
        <label class="consent">
          <input type="checkbox" id="f-consent" required />
          <span>
            <a href="privacy.html" target="_blank" rel="noopener">プライバシーポリシー</a
            >に同意します<span class="req">必須</span>
          </span>
        </label>
      </div>
      <button type="submit" class="btn btn--primary submit" id="f-submit">この内容で相談する</button>
      <p class="msg" id="f-msg" role="status" aria-live="polite"></p>
      <p class="fineprint">
        フォームが送信できない場合は、メール <a
          href="mailto:info@mimoria.jp?subject=MIMORIA%20RECRUIT%20%E7%9B%B8%E8%AB%87"
          >info@mimoria.jp</a
        > へ直接ご連絡いただくか、<a href={lineUrl} target="_blank" rel="noopener"
          >LINEでのご相談</a
        >も可能です。
      </p>
    </form>
  </div>
</section>

<script>
  import '../scripts/inquiry';
</script>

<style>
  /* カンプ下部の文法: 左に大きな見出し、右にたっぷり余白をとった白いフォームカード */
  .contact-grid :global(.section-head h2) {
    font-size: 28px;
    line-height: 1.35;
  }
  .inq {
    max-width: 680px;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-plan);
    box-shadow: var(--shadow-md);
    padding: 28px 22px;
  }
  @media (min-width: 860px) {
    .contact-grid :global(.section-head h2) {
      font-size: 40px;
    }
    .inq {
      padding: 44px 48px;
    }
  }
  @media (min-width: 1024px) {
    .contact-grid {
      display: grid;
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      gap: 64px;
      align-items: start;
    }
    .contact-grid :global(.section-head) {
      text-align: left;
      margin-block-end: 0;
      position: sticky;
      top: 120px;
    }
    .contact-grid :global(.section-head .lead) {
      margin-inline: 0;
    }
    .inq {
      max-width: none;
      margin-inline: 0;
    }
  }
  .fld {
    margin-block-end: 22px;
  }
  .inq label {
    display: block;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.03em;
    margin-block-end: 7px;
  }
  .req {
    color: var(--accent-2);
    font-size: 11.5px;
    font-weight: 700;
    margin-inline-start: 8px;
  }
  .inq input[type='text'],
  .inq input[type='email'],
  .inq input[type='tel'],
  .inq select,
  .inq textarea {
    width: 100%;
    background: #fcfcfa;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-btn);
    color: var(--ink);
    padding: 13px 15px;
    font: inherit;
    font-size: 15px;
    transition:
      border-color 160ms var(--ease-out),
      box-shadow 160ms var(--ease-out);
  }
  .inq textarea {
    min-height: 120px;
    resize: vertical;
  }
  .inq input:focus,
  .inq select:focus,
  .inq textarea:focus {
    outline: none;
    border-color: var(--accent);
    background: #fff;
    box-shadow: 0 0 0 3px rgba(26, 163, 74, 0.2);
  }
  .inq .consent {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    font-size: 13.5px;
    color: var(--ink-2);
    font-weight: 400;
    margin-block-end: 0;
  }
  .inq .consent input {
    margin-top: 5px;
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    accent-color: var(--accent);
  }
  .inq .consent a {
    color: var(--accent-dark);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .submit {
    width: 100%;
    min-height: 58px;
    font-size: 16px;
    margin-block-start: 6px;
  }
  .fineprint a {
    color: var(--accent-dark);
    font-weight: 700;
    text-underline-offset: 3px;
  }
  .submit:disabled {
    opacity: 0.55;
    cursor: wait;
  }
  .msg {
    display: none;
    border-radius: 10px;
    padding: 14px 18px;
    font-size: 14px;
    margin-block-start: 20px;
  }
  .msg.ok {
    display: block;
    background: #eaf7ef;
    border: 1px solid #8fd0a8;
    color: #146c3c;
  }
  .msg.err {
    display: block;
    background: #fdeeea;
    border: 1px solid #d89a86;
    color: #842f1c;
  }
  .fineprint {
    font-size: 12.5px;
    color: var(--ink-3);
    margin-block-start: 14px;
  }
  .hp-field {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }
</style>
